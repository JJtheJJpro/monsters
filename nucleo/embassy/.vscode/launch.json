{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "probe-rs-debug",
            "request": "launch",
            "name": "Debug Embassy App",
            "chip": "STM32F767ZITx", // e.g., "RP2040"
            "preLaunchTask": "cargo build",
            "flashingConfig": {
                "flashingEnabled": true,
                "haltAfterReset": true
            },
            "coreConfigs": [
                {
                    "coreIndex": 0,
                    "programBinary": "target/thumbv7em-none-eabihf/debug/nucleo", // Update target triplet & binary name
                    "rttEnabled": true, // Enables defmt / RTT logging output
                    "rttChannelFormats": [
                        {
                            "channelNumber": 0,
                            "format": "Defmt" // Formats Embassy's defmt macros nicely
                        }
                    ]
                }
            ]
        }
    ]
}